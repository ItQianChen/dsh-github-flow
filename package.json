{
  "name": "dsh-github-flow",
  "version": "0.1.0",
  "icon": "icon.svg",
  "description": "GitHub Flow: Native GitHub CLI (gh) integration for DeepSeek Harness — Agent Tools, Slash Commands, and Web UI Workspace",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "PLAN.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "entry": "./lib/client.js"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "gh-cli",
    "cordis"
  ],
  "author": "DSH Contributor",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
