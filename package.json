{
  "name": "dsh-github-flow",
  "version": "0.2.1",
  "icon": "icon.svg",
  "description": "GitHub 工作流引擎：为 DeepSeek Harness 提供原生 GitHub CLI (gh) 集成——9 大 Agent 领域工具（PR 审查合并、Issue 任务流转、CI 失败诊断、发版交付、密钥管理、Agent Skills 生态）、/gh 人类快捷指令、Web UI 全景驾驶舱与一键跨平台自动升级；零凭证侵入复用宿主机 gh 登录态，内置 Token 防溢出截断、高危操作二次确认与密文安全输入通道。",
  "type": "module",
  "main": "./lib/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ItQianChen/dsh-github-flow.git"
  },
  "homepage": "https://github.com/ItQianChen/dsh-github-flow#readme",
  "bugs": {
    "url": "https://github.com/ItQianChen/dsh-github-flow/issues"
  },
  "exports": {
    ".": "./lib/main.js",
    "./entry": "./lib/main.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "test": "node test/run-all.mjs",
    "prepare": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "entry": "./lib/client.js"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "gh-cli",
    "cordis"
  ],
  "author": "DSH Contributor",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
