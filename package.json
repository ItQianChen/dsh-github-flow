{
  "name": "dsh-github-flow",
  "version": "0.1.2",
  "icon": "icon.svg",
  "description": "GitHub Flow: Native GitHub CLI (gh) integration for DeepSeek Harness — Agent Tools, Slash Commands, and Web UI Workspace",
  "type": "module",
  "main": "./lib/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ItQianChen/dsh-github-flow.git"
  },
  "homepage": "https://github.com/ItQianChen/dsh-github-flow#readme",
  "bugs": {
    "url": "https://github.com/ItQianChen/dsh-github-flow/issues"
  },
  "exports": {
    ".": "./lib/main.js",
    "./entry": "./lib/main.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "prepare": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "entry": "./lib/client.js"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "gh-cli",
    "cordis"
  ],
  "author": "DSH Contributor",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
