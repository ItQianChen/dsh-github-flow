{
  "name": "dsh-github-flow",
  "version": "0.8.0",
  "icon": "icon.svg",
  "description": "让 DeepSeek Harness 拥有操作 GitHub 的原生手脚：零 Token 泄露复用宿主机 gh 凭据，19 个工具 / 100+ action 覆盖 PR、Issue、CI、Release、Secret、Projects、Codespaces 与 Copilot 智能体；执行前人工审核 + 本地操作记录双重卡点，配 /gh 指令与秒开全景驾驶舱。",
  "type": "module",
  "main": "./lib/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ItQianChen/dsh-github-flow.git"
  },
  "homepage": "https://github.com/ItQianChen/dsh-github-flow#readme",
  "bugs": {
    "url": "https://github.com/ItQianChen/dsh-github-flow/issues"
  },
  "exports": {
    ".": "./lib/main.js",
    "./entry": "./lib/main.js",
    "./client": "./lib/client.js",
    "./host": "./lib/github-service.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "test": "node test/run-all.mjs",
    "prepare": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "entry": "./lib/client.js"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "gh-cli",
    "cordis"
  ],
  "author": "DSH Contributor",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
